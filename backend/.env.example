# ============================================
# IWIS Backend — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Required: AI Scanner ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# --- Required: Clerk Authentication ---
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# --- Database (Postgres Production / Single Source of Truth) ---
# Set USE_POSTGRES=true to route all database operations to PostgreSQL
USE_POSTGRES=true
DATABASE_URL=postgresql://iwis_user:password@host:5432/iwis_db

# --- Server & CORS ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app

# --- Features & RAG ---
ENABLE_RAG=true
ENABLE_PHONE_OTP=false

# --- Email (Nodemailer / Gmail App Password) ---
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password